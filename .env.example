# Secrets & environment — NEVER commit real values. Copy to `.env` and fill in.
# The API holds the sensitive credentials; frontends never see these.

# ---- Server ----
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# ---- Database (MongoDB Atlas connection string) ----
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.ax7vlz9.mongodb.net/lumora

# ---- Redis (BullMQ + caching + rate limiting) ----
# REDIS_URL="rediss://default:<password>@<host>:6379"

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=replace-with-another-long-random-string

# ---- Stripe (collection only — see plan section 5.3) ----
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret
# Publishable key is safe client-side — duplicated in perfume-web .env
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key

# ---- Cloudinary (signed uploads) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---- Payout engine schedule (cron, server local time) ----
PAYOUT_BATCH_CRON=0 2 * * 1
