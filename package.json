{
  "name": "perfume-api",
  "version": "1.0.0",
  "description": "Backend API for the multi-vendor perfume marketplace (Bun + Hono + MongoDB + Redis + Stripe + Cloudinary)",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "seed:admin": "bun run scripts/seed-admin.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint . --ext .ts",
    "openapi": "bun src/openapi.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.1",
    "@hono/zod-validator": "^0.9.0",
    "cloudinary": "^2.10.1",
    "dotenv": "^17.4.2",
    "file-type": "^22.0.2",
    "hono": "^4.13.4",
    "mongoose": "^9.9.3",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "stripe": "^22.5.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.3.0",
    "bun-types": "^1.4.0",
    "eslint": "^10.9.1",
    "typescript": "^7.0.2"
  }
}
